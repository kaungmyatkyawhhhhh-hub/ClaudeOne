	xpGain = label({
		Text = "",
		TextSize = 14,
		Font = Enum.Font.GothamBlack,
		TextColor3 = Theme.Accent,
		TextXAlignment = Enum.TextXAlignment.Left,
		TextTransparency = 1,
		TextStrokeTransparency = 1,
		Position = UDim2.new(1, 10, 0, 44),
