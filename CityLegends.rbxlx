	}, { corner(8), stroke(Theme.Stroke, 1.5, 0.1) })
	xpFill = new("Frame", { Size = UDim2.fromScale(0, 1), BackgroundColor3 = WHITE, BorderSizePixel = 0, Parent = back }, { corner(8) })
