local H = require("./harness")
local E = H.module("ReplicatedStorage/Shared/Config/Economy")
print("Login calendar")
H.check(E.LoginDay(0, 0, 100) == 1, "first ever claim = day 1")
H.check(E.LoginDay(100, 3, 100) == nil, "claimed today: nothing")
H.check(E.LoginDay(99, 3, 100) == 4, "next day: day + 1")
H.check(E.LoginDay(99, 7, 100) == 1, "after day 7 the calendar starts over")
H.check(E.LoginDay(97, 5, 100) == 1, "missed a day: back to day 1")
local c7, t7 = E.LoginReward(7)
local c1, t1 = E.LoginReward(1)
H.check(c7 > c1 and t7 >= 1 and t1 == 0, "day 7 is the big one (DNA token)")
for day = 2, 7 do H.check(E.LoginReward(day) >= E.LoginReward(day - 1), "day " .. day .. " pays at least day " .. (day - 1)) end
print("Offline")
H.check(E.OfflineCoins(5 * 60) == 0, "short break: nothing")
H.check(E.OfflineCoins(60 * 60) == 30, "1 hour = 30 coins")
H.check(E.OfflineCoins(48 * 3600) == 240, "capped at 8 hours")
print("Rush hour")
local active, left = E.RushHourAt(1800 * 1000 + 10)
H.check(active and left == 170, "active at :00 for 3 minutes")
active, left = E.RushHourAt(1800 * 1000 + 200)
H.check(not active and left == 1600, "inactive after, next in 1600s")
H.check(E.Day(86400 * 3 + 5) == 3, "day number")
H.done()
