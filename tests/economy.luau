local H = require("./harness")
local E = H.module("ReplicatedStorage/Shared/Config/Economy")
print("Streak")
H.check(select(1, E.NextStreak(0, 0, 100)) == 1, "first ever join = day 1")
local s, claimed = E.NextStreak(100, 5, 100)
H.check(s == 5 and not claimed, "same day: no change")
s, claimed = E.NextStreak(99, 5, 100)
H.check(s == 6 and claimed, "next day: +1")
s = E.NextStreak(97, 10, 100) -- missed 2 days
H.check(s == 10 - 6 + 1, "missed 2 days: drops 6, then +1 (" .. s .. ")")
s = E.NextStreak(50, 4, 100)
H.check(s == 1, "long break: back to 1")
H.check(E.StreakCoins(1) == 25 and E.StreakCoins(100) == 20 + 150, "streak coins capped")
print("Offline")
H.check(E.OfflineCoins(5 * 60) == 0, "short break: nothing")
H.check(E.OfflineCoins(60 * 60) == 30, "1 hour = 30 coins")
H.check(E.OfflineCoins(48 * 3600) == 240, "capped at 8 hours")
print("Rush hour")
local active, left = E.RushHourAt(1800 * 1000 + 10)
H.check(active and left == 170, "active at :00 for 3 minutes")
active, left = E.RushHourAt(1800 * 1000 + 200)
H.check(not active and left == 1600, "inactive after, next in 1600s")
H.check(E.Day(86400 * 3 + 5) == 3, "day number")
H.done()
