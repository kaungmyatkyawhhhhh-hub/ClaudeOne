local H = require("./harness")
local S = H.module("ReplicatedStorage/Shared/Config/ShowOff")
print("Leaderboard scores")
H.check(S.GroupScore(2, 1) > S.GroupScore(1, 9999), "a Growth Spurt outranks any earlier level")
local spurts, level = S.SplitGroupScore(S.GroupScore(3, 42.7))
H.check(spurts == 3 and level == 42, "split score round-trips")
H.check(S.TotalScore(2, 0) > S.TotalScore(1, 999999), "total: spurts first")
print("Membership")
H.check(S.Tier(0).id == "Bronze", "0 reps = Bronze")
local t, n = S.Tier(2500)
H.check(t.id == "Gold" and n.id == "Platinum", "2500 = Gold, next Platinum")
t, n = S.Tier(99999)
H.check(t.id == "Diamond" and n == nil, "Diamond is top")
print("Emotes")
for _, e in S.Emotes do H.check(S.EmoteById[e.id] == e and e.seconds > 0, e.id .. " ok") end
H.check(S.EmoteById.Chug ~= nil, "chug exists")
H.done()
