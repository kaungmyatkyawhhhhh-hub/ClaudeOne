local fs = require("@lune/fs")
local serde = require("@lune/serde")
-- the package folder: Downloads\limb_stages (or a local copy in limb_stages/, git-ignored)
local DOWNLOADS = "C:/Users/kaung/Downloads/limb_stages"
local SRC = if fs.isDir(DOWNLOADS) then DOWNLOADS else "limb_stages"
local spec = serde.decode("json", fs.readFile(SRC .. "/stages.json"))
-- the Mesh asset ids of the imported stage meshes (v9 clean tubes, Import 3D, 8 Oct 2026; also the templates in
-- ReplicatedStorage.LimbStages)
local IDS = {
	LeftLowerArm__Forearms__g000 = 104232401952574, LeftLowerArm__Forearms__g020 = 121351977446187,
	LeftLowerArm__Forearms__g040 = 117111957404941, LeftLowerArm__Forearms__g060 = 107781006835322,
	LeftLowerArm__Forearms__g080 = 115045281020437, LeftLowerArm__Forearms__g100 = 85641953715646,
	LeftLowerArm__Forearms__monster = 119772422681082,
	LeftLowerLeg__Calves__g000 = 94263400999465, LeftLowerLeg__Calves__g020 = 114825270343042,
	LeftLowerLeg__Calves__g040 = 135669953618648, LeftLowerLeg__Calves__g060 = 99553546064235,
	LeftLowerLeg__Calves__g080 = 72185514973888, LeftLowerLeg__Calves__g100 = 70477912756207,
	LeftLowerLeg__Calves__monster = 71548997860162,
	RightLowerArm__Forearms__g000 = 110289781224774, RightLowerArm__Forearms__g020 = 139142047998655,
	RightLowerArm__Forearms__g040 = 80454363835860, RightLowerArm__Forearms__g060 = 137492097782767,
	RightLowerArm__Forearms__g080 = 140674161913939, RightLowerArm__Forearms__g100 = 97239896133357,
	RightLowerArm__Forearms__monster = 136899509536113,
	RightLowerLeg__Calves__g000 = 135484380701597, RightLowerLeg__Calves__g020 = 119055514992687,
	RightLowerLeg__Calves__g040 = 105150171763752, RightLowerLeg__Calves__g060 = 130394052996009,
	RightLowerLeg__Calves__g080 = 119758067624797, RightLowerLeg__Calves__g100 = 92126058222800,
	RightLowerLeg__Calves__monster = 117626792723692,
}
local names = {}
for name in pairs(spec.stages) do table.insert(names, name) end
table.sort(names)
local lines = {
	"--!strict",
	"-- LimbStages: Forearms and Calves as STATIC stage meshes (no EditableMesh, so they never compete for the client's few",
	"-- live meshes). Each limb mesh has 7 stages (look g 0, 0.2 .. 1.0 and the mass monster); the stage nearest to the",
	"-- displayed look is shown, cross-fading over FadeTime when it changes (Shared.LimbStages).",
	"-- GENERATED by tools/gen_limb_stages.luau from limb_stages/ (stages.json + the OBJs): g, file and the OBJ's",
	"-- bounding-box centre in part-local studs (the importer centres a mesh on its bounds, so the part is welded there).",
	"-- id = the uploaded Mesh asset id (0 until uploaded). tools/limb_stages_setup.luau turns them into the templates in",
	"-- ReplicatedStorage.LimbStages that the game clones; without those templates the old EditableMesh forearms / calves stay.",
	"local LimbStages = {}",
	"",
	"LimbStages.FadeTime = 0.3 -- seconds of cross-fade between two stages",
	"-- Studio's Import 3D turns the OBJs 180 degrees around Y (x and z negated, checked vertex by vertex): turned back here",
	"LimbStages.ImportTurn = CFrame.Angles(0, math.pi, 0)",
	"",
	"LimbStages.Meshes = {",
}
for _, name in ipairs(names) do
	local part, muscle = string.match(name, "^(.-)__(.+)$")
	table.insert(lines, string.format("\t%s = { part = %q, muscle = %q, clothing = %q, stages = {", name, part, muscle, if string.find(part, "Arm") then "Shirt" else "Pants"))
	for _, stage in ipairs(spec.stages[name]) do
		local minV, maxV = { math.huge, math.huge, math.huge }, { -math.huge, -math.huge, -math.huge }
		for line in string.gmatch(fs.readFile(SRC .. "/meshes/" .. stage.file), "[^\r\n]+") do
			local x, y, z = string.match(line, "^v%s+(%S+)%s+(%S+)%s+(%S+)")
			if x then
				local v = { tonumber(x), tonumber(y), tonumber(z) }
				for k = 1, 3 do minV[k] = math.min(minV[k], v[k]) maxV[k] = math.max(maxV[k], v[k]) end
			end
		end
		local center = {}
		for k = 1, 3 do center[k] = string.format("%.4f", (minV[k] + maxV[k]) / 2) end
		local size = {}
		for k = 1, 3 do size[k] = string.format("%.4f", maxV[k] - minV[k]) end
		table.insert(lines, string.format("\t\t{ g = %s, file = %q, center = Vector3.new(%s), size = Vector3.new(%s), id = %d },", tostring(stage.g), (string.gsub(stage.file, "%.obj$", "")), table.concat(center, ", "), table.concat(size, ", "), IDS[(string.gsub(stage.file, "%.obj$", ""))] or 0))
	end
	table.insert(lines, "\t} },")
end
table.insert(lines, "}")
table.insert(lines, "")
table.insert(lines, "return LimbStages")
fs.writeFile("src/ReplicatedStorage/Shared/Config/LimbStages.luau", table.concat(lines, "\n") .. "\n")
print("ok", #names)
