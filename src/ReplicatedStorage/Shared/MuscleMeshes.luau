--!strict
-- MuscleMeshes: loads the muscle v8 data (ReplicatedStorage.MuscleData, generated by tools/gen_muscle_data from muscle_v8/)
-- and caches it parsed, once per muscle mesh, shared by every character:
--   base  = the muscle lying flat on the skin      (Vector3 per vertex, part-local studs)
--   delta = max - base                             (vertex at growth g = base + delta * g)
--   uv    = texture coordinates on the classic 585x559 clothing template (Vector2 per vertex, image space: v counts
--           down from the top, like Roblox), so a muscle can wear the character's own Shirt (torso, arms) or Pants (legs)
--   tris  = triangle corners, 0-based vertex indices (flat list, three per triangle)
--   nbase / ndelta = the vertex normal at growth 0 and its change to max (normal = unit(nbase + ndelta * g))
--   vein  = the raised vein offset per vertex (vertex + vein * v)
--   blends[i] = { { key, weight }, ... } for a border vertex: how much it follows a neighbouring muscle mesh's growth
--           (smooth borders at uneven levels: g_v = (1 - sum of weights) * g_own + sum(weight * g_other))
-- Part-local studs: origin = the body part's position, +X = the character's right, +Y up, -Z front.
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Data = ReplicatedStorage:WaitForChild("MuscleData")
local Index = require(Data:WaitForChild("Index") :: ModuleScript) :: any

local LimbStages = require(script.Parent.LimbStages)

local MuscleMeshes = {}
MuscleMeshes.Index = Index
MuscleMeshes.Parts = Index.parts :: { [string]: { size: Vector3 } }

-- A mesh's own muscle name ("UpperTorso__UpperTraps" -> "UpperTraps", "..__Quads_Shorts" -> "Quads"): the key of its
-- mass monster size and of the blend weights.
function MuscleMeshes.MeshKey(name: string): string
	local key = string.match(name, "__(.+)$") or name
	return (string.gsub(key, "_Shorts$", ""))
end
-- The game's muscle id for a mesh record or mesh key (Config.Muscles ids): the upper traps grow with Traps, the round
-- shoulder caps (DeltCap) with Side Delts.
local EXTRA_NAMES: { [string]: string } = { UpperTraps = "Traps", DeltCap = "SideDelts" }
function MuscleMeshes.MuscleId(name: string): string
	local key = MuscleMeshes.MeshKey(name)
	return EXTRA_NAMES[key] or key
end

-- The mass monster size of a mesh (manifest mass_monster.g by mesh key; a mesh grows to it while its muscle goes from 1 to
-- the muscle's own monster size).
local MONSTER_G: { [string]: number } = Index.monsterG or {}
local MONSTER_DEFAULT: number = Index.monsterDefaultG or 1.35
function MuscleMeshes.MonsterG(key: string): number
	return MONSTER_G[key] or MONSTER_DEFAULT
end

MuscleMeshes.Records = {} :: { any }
MuscleMeshes.ByName = {} :: { [string]: any }
for _, record in ipairs(Index.meshes) do
	record.id = MuscleMeshes.MuscleId(record.name)
	record.key = MuscleMeshes.MeshKey(record.name)
	table.insert(MuscleMeshes.Records, record)
	MuscleMeshes.ByName[record.name] = record
end

local function numbers(record: any, field: string): { number }
	local pieces = {}
	for k = 1, record.chunks[field] do
		local module = Data:FindFirstChild(record.name .. "__" .. field .. k)
		assert(module and module:IsA("ModuleScript"), "missing muscle data " .. record.name .. "__" .. field .. k)
		table.insert(pieces, (require(module) :: any) :: string)
	end
	local text = table.concat(pieces, ",")
	local list = {}
	local n = 0
	for value in string.gmatch(text, "[^,]+") do
		n += 1
		list[n] = tonumber(value) :: number
	end
	return list
end

local cache: { [string]: any } = {}

-- Parsed data of one mesh (cached). Takes a few milliseconds the first time.
function MuscleMeshes.Load(name: string): any
	local found = cache[name]
	if found then return found end
	local record = MuscleMeshes.ByName[name]
	assert(record, "unknown muscle mesh " .. name)
	local base, max = numbers(record, "base"), numbers(record, "max")
	local uvList, tris = numbers(record, "uv"), numbers(record, "tris")
	local count = record.verts
	local basePositions, maxPositions, delta, uv = {}, {}, {}, {}
	for i = 1, count do
		local o = (i - 1) * 3
		local b = Vector3.new(base[o + 1], base[o + 2], base[o + 3])
		local m = Vector3.new(max[o + 1], max[o + 2], max[o + 3])
		basePositions[i], maxPositions[i], delta[i] = b, m, m - b
		uv[i] = Vector2.new(uvList[(i - 1) * 2 + 1], uvList[(i - 1) * 2 + 2])
	end
	local data = { base = basePositions, max = maxPositions, delta = delta, uv = uv, tris = tris, verts = count, record = record }
	-- normals (base / max) and veins, when the data has them
	if record.chunks.nbase and record.chunks.nmax then
		local nb, nm = numbers(record, "nbase"), numbers(record, "nmax")
		local nbase, ndelta = table.create(count), table.create(count)
		for i = 1, count do
			local o = (i - 1) * 3
			local b = Vector3.new(nb[o + 1], nb[o + 2], nb[o + 3])
			nbase[i], ndelta[i] = b, Vector3.new(nm[o + 1], nm[o + 2], nm[o + 3]) - b
		end
		data.nbase, data.ndelta = nbase, ndelta
	end
	if record.chunks.vein then
		local v = numbers(record, "vein")
		local vein = table.create(count)
		for i = 1, count do
			local o = (i - 1) * 3
			vein[i] = Vector3.new(v[o + 1], v[o + 2], v[o + 3])
		end
		data.vein = vein
	end
	-- the waist morph under a torso muscle (start - max of the torso surface beneath each vertex; tools/gen_muscle_data)
	if record.chunks.morph then
		local m = numbers(record, "morph")
		local morph = table.create(count)
		for i = 1, count do
			local o = (i - 1) * 3
			morph[i] = Vector3.new(m[o + 1], m[o + 2], m[o + 3])
		end
		data.morph = morph
	end
	-- the torso surface under a torso muscle's vertex (point relative to the vertex, and its normal): the skin edge snaps to it
	if record.chunks.skin then
		local s = numbers(record, "skin")
		local skinAt, skinNormal = table.create(count), table.create(count)
		for i = 1, count do
			local o = (i - 1) * 6
			skinAt[i] = Vector3.new(s[o + 1], s[o + 2], s[o + 3])
			skinNormal[i] = Vector3.new(s[o + 4], s[o + 5], s[o + 6])
		end
		data.skinAt, data.skinNormal = skinAt, skinNormal
	end
	-- border blend weights: "Name:vertex,weight,vertex,weight|Name2:..." (0-based) -> blends[vertex] = { { key, weight } }
	data.blends = {}
	data.blendKeys = {}
	if record.chunks.blend then
		local pieces = {}
		for k = 1, record.chunks.blend do
			local module = Data:FindFirstChild(record.name .. "__blend" .. k)
			table.insert(pieces, module and (require(module :: ModuleScript) :: any) or "")
		end
		for block in string.gmatch(table.concat(pieces, ","), "[^|]+") do
			local other, list = string.match(block, "^([^:]+):(.*)$")
			if other then
				local key = MuscleMeshes.MeshKey(other)
				if not table.find(data.blendKeys, key) then table.insert(data.blendKeys, key) end
				local vertex = nil
				for value in string.gmatch(list, "[^,]+") do
					if vertex == nil then
						vertex = (tonumber(value) :: number) + 1
					else
						local slot = data.blends[vertex]
						if not slot then
							slot = {}
							data.blends[vertex] = slot
						end
						table.insert(slot, { key, tonumber(value) :: number })
						vertex = nil
					end
				end
			end
		end
	end
	cache[name] = data
	return data
end

------------------------------------------------------------------------
-- Merged meshes: the client can only hold a few EditableMeshes at once (8 in Studio; each also holds at most 20,000
-- triangles), so the muscles of one body part are merged into as few meshes as possible. A UNIT is a set of such meshes that
-- grows together (both sides of a pair); units are built in this order of importance.
-- The UpperTorso: the front muscles carry the snatched upper torso in the same mesh (snatched = true: it replaces the body
-- part, morphs with the waist and never grows), so the torso costs 2 meshes (front + torso, back) instead of 3 (the front
-- and back muscles together are over the 20,000 triangle limit). With the forearm / calf stage meshes (Shared.LimbStages)
-- your character holds 7 EditableMeshes: torso front, torso back, the LowerTorso, two upper arms, two upper legs.
------------------------------------------------------------------------
local function names(part: string, list: { string }): { string }
	local out = {}
	for _, muscle in ipairs(list) do table.insert(out, part .. "__" .. muscle) end
	return out
end
local function pair(list: { string }, a: string, b: string)
	return {
		{ part = a, records = names(a, list) },
		{ part = b, records = names(b, list) },
	}
end
MuscleMeshes.Units = {
	{ id = "TorsoFront", alwaysWanted = true, groups = { { part = "UpperTorso", snatched = true, records = names("UpperTorso", { "MidChest", "UpperChest", "Abs", "Obliques" }) } } },
	{ id = "UpperArms", groups = pair({ "FrontDelts", "SideDelts", "RearDelts", "DeltCap", "Biceps", "Triceps" }, "RightUpperArm", "LeftUpperArm") },
	{ id = "UpperLegs", groups = pair({ "Quads", "Quads_Shorts", "Hamstrings", "Hamstrings_Shorts", "Glutes", "Glutes_Shorts" }, "RightUpperLeg", "LeftUpperLeg") },
	{ id = "TorsoBack", groups = { { part = "UpperTorso", records = names("UpperTorso", { "Lats", "UpperTraps", "Traps", "Rhomboids", "LowerBack" }) } } },
	{ id = "Forearms", groups = pair({ "Forearms" }, "RightLowerArm", "LeftLowerArm") },
	{ id = "Calves", groups = pair({ "Calves" }, "RightLowerLeg", "LeftLowerLeg") },
}
-- with the stage meshes in (ReplicatedStorage.LimbStages), forearms and calves need no EditableMesh
if LimbStages.IsOn() then
	for index = #MuscleMeshes.Units, 1, -1 do
		local unit = MuscleMeshes.Units[index]
		if unit.id == "Forearms" or unit.id == "Calves" then table.remove(MuscleMeshes.Units, index) end
	end
end
for _, unit in ipairs(MuscleMeshes.Units) do
	unit.cost = #unit.groups
	unit.muscles = {}
	for _, group in ipairs(unit.groups) do
		for _, name in ipairs(group.records) do
			local record = MuscleMeshes.ByName[name]
			assert(record, "unknown muscle mesh " .. name)
			unit.muscles[record.id] = true
		end
	end
end

local partCache: { [string]: any } = {}

-- The highlight / rep flash covers the muscle's AREA on the body (the same at every level, also flat at level 0): full in
-- the middle, fading out over its last TintRows rows of vertices to its border (an open edge, or where it blends into a
-- neighbour), times how much each vertex stays its own muscle (1 - its blend weights). So the edge is a soft gradient that
-- never reaches the neighbours. Band 0 = no tint .. TintBands = the full tint.
MuscleMeshes.TintBands = 8
MuscleMeshes.TintRows = 4
local function tintBands(data, blends): { number }
	local n = data.verts
	local tris = data.tris
	-- neighbours, and the edges used by one triangle (the mesh's open border)
	local adjacent, edgeUse = table.create(n), {}
	for i = 1, n do adjacent[i] = {} end
	for k = 1, #tris, 3 do
		local corners = { tris[k] + 1, tris[k + 1] + 1, tris[k + 2] + 1 }
		for c = 1, 3 do
			local a, b = corners[c], corners[c % 3 + 1]
			table.insert(adjacent[a], b)
			local key = if a < b then a * 65536 + b else b * 65536 + a
			edgeUse[key] = (edgeUse[key] or 0) + 1
		end
	end
	local own = table.create(n, 1)
	for i = 1, n do
		local list = blends and blends[i]
		if list then
			local o = 1
			for _, pair in ipairs(list) do o -= pair[2] end
			own[i] = math.clamp(o, 0, 1)
		end
	end
	-- rows from the border (breadth first): the border = open-edge vertices and mostly-blended ones
	local rows = table.create(n, math.huge)
	local queue, head = {}, 1
	for key, used in pairs(edgeUse) do
		if used == 1 then
			for _, v in ipairs({ key // 65536, key % 65536 }) do
				if rows[v] ~= 0 then rows[v] = 0 table.insert(queue, v) end
			end
		end
	end
	for i = 1, n do
		if own[i] < 0.5 and rows[i] ~= 0 then rows[i] = 0 table.insert(queue, i) end
	end
	while head <= #queue do
		local v = queue[head]
		head += 1
		for _, w in ipairs(adjacent[v]) do
			if rows[w] > rows[v] + 1 then
				rows[w] = rows[v] + 1
				table.insert(queue, w)
			end
		end
	end
	local bands = table.create(n)
	for i = 1, n do
		local t = math.clamp(rows[i] / MuscleMeshes.TintRows, 0, 1)
		t = t * t * (3 - 2 * t)
		bands[i] = math.floor(t * own[i] * MuscleMeshes.TintBands + 0.5)
	end
	return bands
end
MuscleMeshes.TintBandsOf = tintBands
-- Muscles sit this far off the skin (studs, along the vertex's base normal). The muscle data lies exactly on the body, so
-- without it the muscle and the snatched torso fight for depth and their borders show as stair-steps; the skirts on outer
-- edges tuck 0.16 into the body, so the lift never opens a gap.
local SKIN_LIFT = 0.02
-- The skin edge of a torso muscle (open-edge vertices that don't blend into a neighbour, and the next rows) becomes the
-- torso surface under it, position and normal, by these weights per row: the outline (stair-stepped in the data) then
-- has nothing to show against, the shell blends into the torso. EDGE_SINK keeps it a hair under the torso.
MuscleMeshes.EdgeSnap = { [0] = 1, [1] = 0.75, [2] = 0.4, [3] = 0.12 }
local EDGE_SINK = 0.004
-- (an edge farther than this from the torso, like the armpit or neck edges that lie on other parts, fades out of the snap)
local SNAP_NEAR, SNAP_FAR = 0.08, 0.2
local function edgeRows(data): { [number]: number }
	local blendSum = {}
	for i, list in pairs(data.blends or {}) do
		local s = 0
		for _, pair in ipairs(list) do s += pair[2] end
		blendSum[i] = s
	end
	local use, adjacent = {}, {}
	local t = data.tris
	for k = 1, #t, 3 do
		local corners = { t[k] + 1, t[k + 1] + 1, t[k + 2] + 1 }
		for c = 1, 3 do
			local a, b = corners[c], corners[c % 3 + 1]
			adjacent[a] = adjacent[a] or {}
			table.insert(adjacent[a], b)
			local key = if a < b then a * 65536 + b else b * 65536 + a
			use[key] = (use[key] or 0) + 1
		end
	end
	local rows = {}
	for key, n in pairs(use) do
		if n == 1 then
			for _, v in ipairs({ key // 65536, key % 65536 }) do
				if (blendSum[v] or 0) < 0.2 then rows[v] = 0 end
			end
		end
	end
	local frontier = {}
	for v in pairs(rows) do table.insert(frontier, v) end
	for row = 1, 3 do
		local nextFrontier = {}
		for _, v in ipairs(frontier) do
			for _, w in ipairs(adjacent[v] or {}) do
				if rows[w] == nil and (blendSum[w] or 0) < 0.2 then
					rows[w] = row
					table.insert(nextFrontier, w)
				end
			end
		end
		frontier = nextFrontier
	end
	return rows
end

-- The merged data of one group { part, records }: one set of arrays for all its muscles. Each range (one mesh) knows its
-- muscle id, its mesh key and the neighbouring mesh keys it blends with (range.blendKeys); blends[vertex] lists them.
function MuscleMeshes.LoadGroup(group: any, withSnatched: boolean?): any
	local snatched = if group.snatched and withSnatched then MuscleMeshes.LoadSnatched(group.part) else nil
	local key = table.concat(group.records, "+") .. (if snatched then "+Snatched" else "")
	local found = partCache[key]
	if found then return found end
	local base, delta, uv, tris, faceKind, ranges = {}, {}, {}, {}, {}, {}
	local nbase, ndelta, vein, blends, bands, morph = {}, {}, {}, {}, {}, {}
	local snapK, skinPos, skinNormal = {}, {}, {}
	local hasMorph = false
	local hasNormals, hasVeins = true, true
	local vertexCount, triCount = 0, 0
	for _, name in ipairs(group.records) do
		local data = MuscleMeshes.Load(name)
		local record = data.record
		table.insert(ranges, { id = record.id, key = record.key, shorts = record.shorts == true, first = vertexCount + 1, count = data.verts, triFirst = triCount + 1, triCount = #data.tris / 3, blendKeys = data.blendKeys })
		hasNormals = hasNormals and data.nbase ~= nil
		hasVeins = hasVeins and data.vein ~= nil
		-- the muscle's centre and average outward direction (half grown), for "is it facing the camera"
		local centerSum, normalSum = Vector3.zero, Vector3.zero
		for i = 1, data.verts do
			local p = data.base[i] + data.delta[i] * 0.5
			centerSum += p
			normalSum += if data.nbase then data.nbase[i] + data.ndelta[i] * 0.5 else p
		end
		local range = ranges[#ranges]
		range.center = centerSum / math.max(data.verts, 1)
		range.normal = if normalSum.Magnitude > 1e-6 then normalSum.Unit else Vector3.zAxis * -1
		data.bands = data.bands or tintBands(data, data.blends)
		local own = data.bands
		local edge = if record.part == "UpperTorso" then edgeRows(data) else {}
		for i = 1, data.verts do
			bands[vertexCount + i] = own[i]
		end
		for i = 1, data.verts do
			local at = vertexCount + i
			base[at] = if data.nbase and data.nbase[i].Magnitude > 1e-6 then data.base[i] + data.nbase[i].Unit * SKIN_LIFT else data.base[i]
			-- the skin edge: how much it snaps onto the torso (MuscleRig blends position and normal toward skinPos / skinNormal)
			local k = edge[i] and MuscleMeshes.EdgeSnap[edge[i]]
			if k and data.skinAt then
				local fade = math.clamp((SNAP_FAR - data.skinAt[i].Magnitude) / (SNAP_FAR - SNAP_NEAR), 0, 1)
				k *= fade * fade * (3 - 2 * fade)
			end
			if k and k > 0 and data.skinAt and data.skinAt[i].Magnitude > 1e-6 then
				snapK[at] = k
				skinPos[at] = data.base[i] + data.skinAt[i] - data.skinNormal[i] * EDGE_SINK
				skinNormal[at] = data.skinNormal[i]
			end
			delta[at] = data.delta[i]
			uv[at] = data.uv[i]
			if data.nbase then nbase[at], ndelta[at] = data.nbase[i], data.ndelta[i] end
			if data.vein then vein[at] = data.vein[i] end
			blends[at] = data.blends[i]
			if data.morph then morph[at] = data.morph[i] end
		end
		hasMorph = hasMorph or data.morph ~= nil
		local kind = if record.shorts then 2 elseif record.part == "UpperTorso" then 3 else 1
		local t = data.tris
		for k = 1, #t, 3 do
			triCount += 1
			tris[triCount * 3 - 2] = t[k] + vertexCount
			tris[triCount * 3 - 1] = t[k + 1] + vertexCount
			tris[triCount * 3] = t[k + 2] + vertexCount
			faceKind[triCount] = kind
		end
		vertexCount += data.verts
	end
	-- the snatched torso as one more range: its shape (the snatched max) in base, the wide start in morphStart, no growth
	local morphStart, owners, ownerFacing, pushFront, pushBack = nil, nil, nil, nil, nil
	if snatched then
		morphStart, owners = {}, {}
		ownerFacing, pushFront, pushBack = {}, {}, {}
		local count = #snatched.verts
		local range = { id = "Snatched", key = "Snatched", snatched = true, shorts = false, first = vertexCount + 1, count = count,
			triFirst = triCount + 1, triCount = #snatched.tris / 3, blendKeys = {} }
		table.insert(ranges, range)
		for i = 1, count do
			local at = vertexCount + i
			base[at] = snatched.verts[i]
			morphStart[at] = if snatched.start then snatched.start[i] else snatched.verts[i]
			delta[at] = Vector3.zero
			uv[at] = snatched.uv[i]
			local normal = if snatched.normals then snatched.normals[i] else Vector3.yAxis
			nbase[at], ndelta[at] = normal, Vector3.zero
			vein[at] = Vector3.zero
			-- pushed inward under the muscle shells (no z-fighting), the same at every waist width: always under the front
			-- muscles (built with the torso), under the back muscles only while those are built (MuscleRig picks)
			pushFront[at] = -normal * ((snatched.push and snatched.push[i]) or 0)
			pushBack[at] = -normal * ((snatched.pushBack and snatched.pushBack[i]) or 0)
			-- tinted with the muscle it lies under (its band at the owner's nearest vertex), so the highlight looks the same
			-- whichever surface shows; owners[at] = { muscle id, band }
			local owner = snatched.owner and snatched.owner[i]
			if owner and owner ~= "" then
				local meshName, vertex = string.match(owner, "^(.-):(%d+)$")
				local record = meshName and MuscleMeshes.ByName[meshName]
				if record then
					local ownerData = MuscleMeshes.Load(meshName)
					ownerData.bands = ownerData.bands or tintBands(ownerData, ownerData.blends)
					owners[at] = { record.id, ownerData.bands[(tonumber(vertex) :: number) + 1] or 0 }
					if not ownerFacing[record.id] then
						local centerSum, normalSum = Vector3.zero, Vector3.zero
						for j = 1, ownerData.verts do
							centerSum += ownerData.base[j] + ownerData.delta[j] * 0.5
							normalSum += if ownerData.nbase then ownerData.nbase[j] else Vector3.zero
						end
						ownerFacing[record.id] = { center = centerSum / math.max(ownerData.verts, 1), normal = if normalSum.Magnitude > 1e-6 then normalSum.Unit else -Vector3.zAxis }
					end
				end
			end
			bands[at] = 0
		end
		local t = snatched.tris
		for k = 1, #t, 3 do
			triCount += 1
			tris[triCount * 3 - 2] = t[k] + vertexCount
			tris[triCount * 3 - 1] = t[k + 1] + vertexCount
			tris[triCount * 3] = t[k + 2] + vertexCount
			faceKind[triCount] = 3
		end
		vertexCount += count
	end
	assert(triCount <= 20000, "group " .. key .. " has more than 20,000 triangles")
	local merged = { verts = vertexCount, base = base, delta = delta, uv = uv, tris = tris, blends = blends, morphStart = morphStart, bands = bands,
		morph = if hasMorph then morph else nil, owners = owners, snapK = snapK, skinPos = skinPos, skinNormal = skinNormal, ownerFacing = ownerFacing, pushFront = pushFront, pushBack = pushBack,
		nbase = hasNormals and nbase or nil, ndelta = hasNormals and ndelta or nil, vein = hasVeins and vein or nil,
		clothing = MuscleMeshes.ByName[group.records[1]].clothing or "Shirt", faceKind = faceKind, ranges = ranges, triCount = triCount }
	partCache[key] = merged
	return merged
end

------------------------------------------------------------------------
-- The snatched-waist torso (muscle v8 body/): replaces the look of UpperTorso and LowerTorso for everyone.
-- { verts = { Vector3 }, uv = { Vector2 }, tris = { 0-based }, normals = { Vector3 }?, start = { Vector3 }? } in part-local
-- studs (cached). verts = the snatched (max) shape; start = the wide straight waist at level 0 (the waist morph: a
-- vertex sits at start + (verts - start) * w as the body grows).
------------------------------------------------------------------------
local snatchedCache: { [string]: any } = {}
function MuscleMeshes.LoadSnatched(part: string): any
	local found = snatchedCache[part]
	if found then return found end
	local module = Data:FindFirstChild("Snatched" .. part)
	if not module or not module:IsA("ModuleScript") then return nil end
	local raw = require(module) :: any
	local verts, uv = {}, {}
	for i = 1, #raw.verts // 3 do
		verts[i] = Vector3.new(raw.verts[i * 3 - 2], raw.verts[i * 3 - 1], raw.verts[i * 3])
		uv[i] = Vector2.new(raw.uv[i * 2 - 1], raw.uv[i * 2])
	end
	local data = { verts = verts, uv = uv, tris = raw.tris, normals = nil :: { Vector3 }?, start = nil :: { Vector3 }?,
		push = raw.push, pushBack = raw.pushBack, owner = raw.owner }
	if raw.start and #raw.start == #raw.verts then
		local start = {}
		for i = 1, #raw.start // 3 do start[i] = Vector3.new(raw.start[i * 3 - 2], raw.start[i * 3 - 1], raw.start[i * 3]) end
		data.start = start
	end
	if raw.normals and #raw.normals == #raw.verts then
		local normals = {}
		for i = 1, #raw.normals // 3 do
			local n = Vector3.new(raw.normals[i * 3 - 2], raw.normals[i * 3 - 1], raw.normals[i * 3])
			normals[i] = if n.Magnitude > 1e-6 then n.Unit else Vector3.yAxis
		end
		data.normals = normals
	end
	snatchedCache[part] = data
	return data
end

return MuscleMeshes
