--!strict
-- MuscleMeshes: loads the muscle data (ReplicatedStorage.MuscleData, generated by tools/gen_muscle_data from the v9 unified
-- package) and caches it parsed, shared by every character. Part-local studs: origin = the body part's position, +X = the
-- character's right, +Y up, -Z front. Two kinds of mesh:
--   * UNIFIED (UpperTorso, RightUpperArm, LeftUpperArm): one welded mesh = the whole skin of the body part, so any mix of
--     levels is one smooth surface (no holes, no seams). Per vertex: base, uv, vein, morph (torso: the waist), nbase; per
--     muscle the vertices it moves (idx) with their displacement at its full look (disp) and the normal change (nidx / ndisp):
--       position = base + morph * (1 - waistT) + sum over muscles(g_m * disp_m) + vein * veinAmount
--       normal   = unit(nbase + sum over muscles(g_m * ndisp_m))
--     The torso has 39,600 triangles and a mesh holds at most 20,000, so it is drawn as two meshes (front / back halves by
--     each triangle's centre); both halves take their vertices from the same data, so the cut never shows.
--   * SHELL (legs, forearms, calves, the upper traps): a muscle lying on the skin that rises: base + (max - base) * g,
--     border "blend" weights toward neighbouring meshes (legs), normals nbase / nmax, vein, morph (upper traps).
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Data = ReplicatedStorage:WaitForChild("MuscleData")
local Index = require(Data:WaitForChild("Index") :: ModuleScript) :: any

local MuscleMeshes = {}
MuscleMeshes.Index = Index
MuscleMeshes.Parts = Index.parts :: { [string]: { size: Vector3 } }

-- A shell mesh's own muscle name ("RightUpperLeg__Quads" -> "Quads", "..__Quads_Shorts" -> "Quads"): its mass monster size
-- and blend key.
function MuscleMeshes.MeshKey(name: string): string
	local key = string.match(name, "__(.+)$") or name
	return (string.gsub(key, "_Shorts$", ""))
end
-- The game's muscle id for a mesh key.
function MuscleMeshes.MuscleId(name: string): string
	return MuscleMeshes.MeshKey(name)
end

-- The mass monster size of a mesh / muscle (manifest mass_monster.g by name).
local MONSTER_G: { [string]: number } = Index.monsterG or {}
local MONSTER_DEFAULT: number = Index.monsterDefaultG or 1.35
-- The shape layers (the traps yoke, the round delt caps; see addUpperTraps / addRoundDelts) grow with their muscle's level
-- but have their own, gentler mass monster size (key "<muscle>@shape"): times the data's own monster sizes they made
-- horns and folded wings.
MuscleMeshes.ShapeMonsterG = { Traps = 1.6, FrontDelts = 1.6, SideDelts = 1.6, RearDelts = 1.6, Rhomboids = 1.7, LowerBack = 1.7, Quads = 1.3 } :: { [string]: number }
function MuscleMeshes.MonsterG(key: string): number
	local muscle = string.match(key, "^(.-)@shape$")
	if muscle then return MuscleMeshes.ShapeMonsterG[muscle] or 1.3 end
	return MONSTER_G[key] or MONSTER_DEFAULT
end

MuscleMeshes.Records = {} :: { any }
MuscleMeshes.ByName = {} :: { [string]: any }
for _, record in ipairs(Index.meshes) do
	if record.format == "shell" then
		record.id = MuscleMeshes.MuscleId(record.name)
		record.key = MuscleMeshes.MeshKey(record.name)
	end
	table.insert(MuscleMeshes.Records, record)
	MuscleMeshes.ByName[record.name] = record
end

local function numbers(record: any, field: string): { number }
	local count = record.chunks[field]
	if not count then return {} end
	local pieces = {}
	for k = 1, count do
		local module = Data:FindFirstChild(record.name .. "__" .. field .. k)
		assert(module and module:IsA("ModuleScript"), "missing muscle data " .. record.name .. "__" .. field .. k)
		table.insert(pieces, (require(module) :: any) :: string)
	end
	local list = {}
	local n = 0
	for value in string.gmatch(table.concat(pieces, ","), "[^,]+") do
		n += 1
		list[n] = tonumber(value) :: number
	end
	return list
end
local function vectors(list: { number }): { Vector3 }
	local out = table.create(#list // 3)
	for i = 1, #list // 3 do out[i] = Vector3.new(list[i * 3 - 2], list[i * 3 - 1], list[i * 3]) end
	return out
end

------------------------------------------------------------------------
-- Tints: the stats hover highlight and the rep flash are vertex colors. Each muscle gets TintBands + 1 colors (band 0 = no
-- tint .. TintBands = the full tint), so a whole fade costs a handful of SetColor calls.
------------------------------------------------------------------------
MuscleMeshes.TintBands = 8
MuscleMeshes.TintRows = 4

------------------------------------------------------------------------
-- Unified meshes
------------------------------------------------------------------------
local unifiedCache: { [string]: any } = {}
-- The whole unified mesh of one body part (parsed once): base, uv, vein, morph, nbase (Vector3 / Vector2 lists), tris
-- (0-based), muscles[name] = { idx = { vertex (1-based) }, disp = { Vector3 }, nidx, ndisp }.
-- Shape changes on top of the muscle data (owner, 19 Oct). Two kinds, both per vertex and per muscle:
--   data.shapes[muscle] = { idx, disp, nidx, ndisp }: a SHAPE LAYER that grows with the muscle's level but has its own mass
--     monster size (MuscleMeshes.MonsterG("<muscle>@shape")); drawn by MuscleRig / tools/gen_body_stages next to the muscle
--   data.reshape[muscle][vertex] = the change made to the muscle's own growth (Vector3 at the full look; under the delt
--     caps the data's delts fade out)
-- tools/reshape_stage_corrections moves the owner's low-poly body stage meshes by both.
local function ease(t: number): number
	t = math.clamp(t, 0, 1)
	return t * t * (3 - 2 * t)
end
local function indexOf(list)
	local at = {}
	for j, v in ipairs(list) do at[v] = j end
	return at
end
-- adds to a muscle's shape layer at one vertex
local function addShape(data, muscle: string, v: number, value: Vector3)
	if not data.muscles[muscle] or value.Magnitude < 1e-6 then return end
	data.shapes = data.shapes or {}
	local s = data.shapes[muscle]
	if not s then
		s = { idx = {}, disp = {}, nidx = {}, ndisp = {}, at = {} }
		data.shapes[muscle] = s
	end
	local j = s.at[v]
	if j then
		s.disp[j] += value
	else
		table.insert(s.idx, v)
		table.insert(s.disp, value)
		s.at[v] = #s.idx
	end
end
-- scales a muscle's own growth at one vertex (recorded in data.reshape)
local function scaleMuscle(data, muscle: string, v: number, factor: number)
	local m = data.muscles[muscle]
	if not m then return end
	m.at = m.at or indexOf(m.idx)
	local j = m.at[v]
	if not j or factor == 1 then return end
	local old = m.disp[j]
	m.disp[j] = old * factor
	data.reshape = data.reshape or {}
	data.reshape[muscle] = data.reshape[muscle] or {}
	data.reshape[muscle][v] = m.disp[j] - old
end

-- After a reshape the data's normal changes no longer fit the new shape (the light would still show the old lumps): at the
-- vertices a muscle's growth changed and for every shape layer, the normal change becomes the geometric one (the smooth
-- vertex normals of base + that growth minus those of base; vertices at the same spot, e.g. along a UV seam, share one).
local function vertexNormals(data, positions)
	local byKey, keyOf = {}, table.create(#positions)
	for i in ipairs(positions) do
		local p = data.base[i]
		local key = math.floor(p.X * 1e4 + 0.5) .. "," .. math.floor(p.Y * 1e4 + 0.5) .. "," .. math.floor(p.Z * 1e4 + 0.5)
		keyOf[i] = key
		byKey[key] = byKey[key] or Vector3.zero
	end
	local t = data.tris
	for k = 1, #t, 3 do
		local a, b, c = t[k] + 1, t[k + 1] + 1, t[k + 2] + 1
		local n = (positions[b] - positions[a]):Cross(positions[c] - positions[a]) -- (area weighted)
		byKey[keyOf[a]] += n
		byKey[keyOf[b]] += n
		byKey[keyOf[c]] += n
	end
	local out = table.create(#positions)
	for i = 1, #positions do
		local n = byKey[keyOf[i]]
		out[i] = if n.Magnitude > 1e-9 then n.Unit else Vector3.yAxis
	end
	return out
end
local function normalsFor(data, plain, idx, disp, vertices)
	local positions = table.clone(data.base)
	for j, v in ipairs(idx) do positions[v] += disp[j] end
	local grown = vertexNormals(data, positions)
	local out = {}
	for v in pairs(vertices) do out[v] = grown[v] - plain[v] end
	return out
end
local function fitNormals(data)
	if not data.reshape and not data.shapes then return end
	local plain = vertexNormals(data, data.base)
	for muscle, changed in pairs(data.reshape or {}) do
		local m = data.muscles[muscle]
		local fitted = normalsFor(data, plain, m.idx, m.disp, changed)
		local nat = indexOf(m.nidx)
		for v, d in pairs(fitted) do
			local j = nat[v]
			if j then
				m.ndisp[j] = d
			else
				table.insert(m.nidx, v)
				table.insert(m.ndisp, d)
				nat[v] = #m.nidx
			end
		end
	end
	for _, s in pairs(data.shapes or {}) do
		local fitted = normalsFor(data, plain, s.idx, s.disp, s.at)
		for v, d in pairs(fitted) do
			table.insert(s.nidx, v)
			table.insert(s.ndisp, d)
		end
	end
end

-- The traps yoke (owner, 19 Oct: "one wide, smooth slope from the base of the neck all the way out to the top of each
-- shoulder"; the data only lifted a thin strip beside the neck). A Traps shape layer lifts the top of the torso: Height
-- (studs at the full look, part-local) from NeckTo to PeakTo out from the middle (rising from NeckFrom, so the base of the
-- neck lifts too: one mound, no horns), sloping down from there to none at ShoulderTo (past the torso's edge: some is left
-- where the delts start); only the top Depth of the torso (easing in over Edge); the front of the top gets FrontShare of it,
-- the back all; Back = a backward push with it (thick from behind). In that top band the data's own Traps growth fades out
-- (fully above Top - Depth + Edge): at the mass monster it stood up as two horns beside the neck. The mid traps (the
-- diamond between the shoulder blades) below it stay the data's.
-- (owner, 19 Oct: "make the upper traps way bigger" (Height 0.52), then "smaller, like 0.32 at full look": Height 0.32, Back
-- 0.1, Depth 0.6, monster 1.6)
local UPPER_TRAPS = { Height = 0.32, Back = 0.1, NeckFrom = -0.2, NeckTo = 0.2, PeakTo = 0.36, ShoulderTo = 1.3, Depth = 0.6, Edge = 0.3, FrontShare = 0.15 }
local function addUpperTraps(data)
	if not data.muscles.Traps then return end
	local top = -math.huge
	for _, p in ipairs(data.base) do top = math.max(top, p.Y) end
	local U = UPPER_TRAPS
	for v, p in ipairs(data.base) do
		local ax = math.abs(p.X)
		local across = ease((ax - U.NeckFrom) / (U.NeckTo - U.NeckFrom)) * (1 - ease((ax - U.PeakTo) / (U.ShoulderTo - U.PeakTo)))
		local down = ease((p.Y - (top - U.Depth)) / U.Edge)
		local side = U.FrontShare + (1 - U.FrontShare) * ease((p.Z + 0.3) / 0.5)
		local w = across * down * side
		if down > 0.001 then scaleMuscle(data, "Traps", v, 1 - down) end
		if w > 0.001 then addShape(data, "Traps", v, Vector3.new(0, U.Height, U.Back) * w) end
	end
end

-- A full back (owner, 19 Oct prompt 8: "the back looks hollow"; at the full look the middle of the back sat up to 0.2 studs
-- lower than the muscles beside it, a deep spine valley and a dip between the rhomboids and the lats). At each height the
-- back is filled up to its ridge (the most the back sticks out within Ridge studs of the middle, smoothed over the
-- neighbouring heights) minus a shallow spine Groove (GrooveWidth wide): the mid traps / rhomboids become a raised
-- diamond, the lower back two thick columns beside a shallow groove. Only within Width of the middle (easing out over
-- WidthEdge), from Bottom to Top (easing over Edge), on the back-facing surface, at most Max studs at the full look. The
-- fill is a shape layer: Rhomboids above Split, LowerBack below it (blended over SplitEdge).
local BACK = { Ridge = 0.5, Groove = 0.04, GrooveWidth = 0.08, Width = 0.38, WidthEdge = 0.2, Bottom = -0.88, Top = 0.62, Edge = 0.18, Max = 0.25, Split = -0.05, SplitEdge = 0.25 }
local function addBackFill(data)
	if not (data.muscles.Rhomboids and data.muscles.LowerBack) then return end
	local B = BACK
	-- every vertex at the full look (every muscle's own growth)
	local full = table.clone(data.base)
	for _, m in pairs(data.muscles) do
		for j, v in ipairs(m.idx) do full[v] += m.disp[j] end
	end
	local BIN = 0.05
	local ridge = {}
	for v, p in ipairs(full) do
		local b = data.base[v]
		if b.Z > 0.1 and math.abs(b.X) < B.Ridge then
			local k = math.floor(b.Y / BIN + 0.5)
			ridge[k] = math.max(ridge[k] or -math.huge, p.Z)
		end
	end
	-- smoothed over the neighbouring heights (a plain step per bin made stripes across the back), then blended between bins
	local smooth = {}
	for k in pairs(ridge) do
		local sum, weight = 0, 0
		for o = -3, 3 do
			local r = ridge[k + o]
			if r then
				local w = 4 - math.abs(o)
				sum += r * w
				weight += w
			end
		end
		smooth[k] = sum / weight
	end
	local function ridgeAt(y: number): number
		local f = y / BIN
		local k = math.floor(f)
		local a, b = smooth[k], smooth[k + 1]
		if a and b then return a + (b - a) * (f - k) end
		return a or b or -math.huge
	end
	for v, b in ipairs(data.base) do
		local n = data.nbase[v]
		if b.Z <= 0.05 or not n or n.Z <= 0.2 then continue end
		local wx = 1 - ease((math.abs(b.X) - B.Width) / B.WidthEdge)
		local wy = ease((b.Y - B.Bottom) / B.Edge) * (1 - ease((b.Y - B.Top) / B.Edge))
		local wn = ease((n.Z - 0.2) / 0.3)
		local w = wx * wy * wn
		if w <= 0.001 then continue end
		local target = ridgeAt(b.Y) - B.Groove * math.exp(-(b.X / B.GrooveWidth) ^ 2)
		local fill = math.clamp(target - full[v].Z, 0, B.Max) * w
		if fill <= 0.001 then continue end
		local upper = ease((b.Y - B.Split) / B.SplitEdge + 0.5)
		addShape(data, "Rhomboids", v, Vector3.new(0, 0, fill * upper))
		addShape(data, "LowerBack", v, Vector3.new(0, 0, fill * (1 - upper)))
	end
end

-- Round delts (owner, 19 Oct: "big round caps like half-balls sitting on the outside of the shoulder"; the data's delts
-- were lumpy, folded and pointy on top). On the top of the upper arm (fully from CapFull, easing in from CapFrom, part-local
-- height) the data's delts fade out and the three delt heads grow as ONE smooth cap (their shape layers): at the full look
-- every vertex sits on an ellipsoid around Center (the box-like arm's corners pull in, its sides swell out: a half-ball),
-- with the semi-axes Out (away from the body), Inner (toward it), Up, Down (into the arm) and Depth (front / back); the
-- front, side and rear delts each take the part that faces their way (FrontFrom .. FrontTo of the vertex's Z), so each still
-- grows with its own level. Below the cap the data's own delts stay.
-- (owner, 19 Oct: "the triceps, biceps look very weird": the first cap reached down to the elbow and swallowed the arm into
-- one ball; now it is only the top of the arm, the biceps and triceps show below it)
local DELTS = { CapFrom = -0.12, CapFull = 0.2, Center = Vector3.new(-0.02, 0.24, 0), Out = 0.56, Inner = 0.36, Up = 0.44, Down = 0.46, Depth = 0.5, FrontFrom = 0.04, FrontTo = 0.28 }
local function addRoundDelts(data, outward: number)
	local D = DELTS
	for v, p in ipairs(data.base) do
		local q = Vector3.new(p.X * outward, p.Y, p.Z) -- (+X = away from the body, either arm)
		local cap = ease((q.Y - D.CapFrom) / (D.CapFull - D.CapFrom))
		if cap <= 0.001 then continue end
		local offset = q - D.Center
		local dir = if offset.Magnitude > 1e-6 then offset.Unit else Vector3.yAxis
		local ax = if dir.X > 0 then D.Out else D.Inner
		local ay = if dir.Y > 0 then D.Up else D.Down
		local radius = 1 / math.sqrt((dir.X / ax) ^ 2 + (dir.Y / ay) ^ 2 + (dir.Z / D.Depth) ^ 2)
		local grow = D.Center + dir * radius - q
		grow = Vector3.new(grow.X * outward, grow.Y, grow.Z)
		local front = ease((-q.Z - D.FrontFrom) / (D.FrontTo - D.FrontFrom))
		local rear = ease((q.Z - D.FrontFrom) / (D.FrontTo - D.FrontFrom))
		local shares = { FrontDelts = front, RearDelts = rear, SideDelts = math.max(1 - front - rear, 0) }
		for muscle, share in pairs(shares) do
			scaleMuscle(data, muscle, v, 1 - cap)
			addShape(data, muscle, v, grow * share * cap)
		end
	end
end

function MuscleMeshes.LoadUnified(name: string): any
	local found = unifiedCache[name]
	if found then return found end
	local record = MuscleMeshes.ByName[name]
	assert(record and record.format == "unified", "not a unified muscle mesh: " .. name)
	local uvList = numbers(record, "uv")
	local uv = table.create(record.verts)
	for i = 1, record.verts do uv[i] = Vector2.new(uvList[i * 2 - 1], uvList[i * 2]) end
	local data = {
		record = record, verts = record.verts,
		base = vectors(numbers(record, "base")), uv = uv, tris = numbers(record, "tris"),
		vein = if record.chunks.vein then vectors(numbers(record, "vein")) else nil,
		morph = if record.chunks.morph then vectors(numbers(record, "morph")) else nil,
		nbase = vectors(numbers(record, "nbase")),
		muscles = {},
	}
	for _, muscle in ipairs(record.muscles) do
		local idx, nidx = numbers(record, "idx_" .. muscle), numbers(record, "nidx_" .. muscle)
		for i, v in ipairs(idx) do idx[i] = v + 1 end
		for i, v in ipairs(nidx) do nidx[i] = v + 1 end
		data.muscles[muscle] = { idx = idx, disp = vectors(numbers(record, "disp_" .. muscle)), nidx = nidx, ndisp = vectors(numbers(record, "ndisp_" .. muscle)) }
	end
	if record.part == "UpperTorso" then
		addUpperTraps(data)
		addBackFill(data)
	end
	if record.part == "RightUpperArm" then addRoundDelts(data, 1) end
	if record.part == "LeftUpperArm" then addRoundDelts(data, -1) end
	fitNormals(data)
	unifiedCache[name] = data
	return data
end

local pieceCache: { [string]: any } = {}
-- One drawn piece of a unified mesh: the whole mesh (half = nil) or the torso's front / back half (half = "Front" / "Back").
-- Its own vertex list (local ids), and per muscle only its vertices in this piece:
--   { verts, global = { global index }, base, uv, vein, morph, nbase (local), tris (local, 0-based), muscles[name] = { idx,
--     disp, nidx, ndisp } (local), dominant[v] = muscle name or false, band[v] = tint band, center / normal per muscle }
function MuscleMeshes.LoadPiece(name: string, half: string?): any
	local key = name .. ":" .. (half or "All")
	local found = pieceCache[key]
	if found then return found end
	local data = MuscleMeshes.LoadUnified(name)
	local tris = data.tris
	local localOf, global = {}, {}
	local outTris = {}
	for k = 1, #tris, 3 do
		local a, b, c = tris[k] + 1, tris[k + 1] + 1, tris[k + 2] + 1
		local keep = true
		if half then
			local z = data.base[a].Z + data.base[b].Z + data.base[c].Z
			keep = if half == "Front" then z < 0 else z >= 0
		end
		if keep then
			for _, v in ipairs({ a, b, c }) do
				if not localOf[v] then
					table.insert(global, v)
					localOf[v] = #global
				end
				table.insert(outTris, localOf[v] - 1)
			end
		end
	end
	local n = #global
	local piece = { name = name, half = half, verts = n, global = global, tris = outTris, triCount = #outTris // 3,
		base = table.create(n), uv = table.create(n), nbase = table.create(n), vein = if data.vein then table.create(n) else nil,
		morph = if data.morph then table.create(n) else nil, muscles = {}, muscleNames = {} }
	for i, v in ipairs(global) do
		piece.base[i], piece.uv[i], piece.nbase[i] = data.base[v], data.uv[v], data.nbase[v]
		if piece.vein then piece.vein[i] = data.vein[v] end
		if piece.morph then piece.morph[i] = data.morph[v] end
	end
	-- each muscle's vertices in this piece, and its tint weight per vertex: |disp| / the muscle's largest |disp| (a soft edge for
	-- free); every vertex takes the muscle with the largest weight (its tint set) at that weight's band
	local weight, dominant, band = table.create(n, 0), table.create(n, false), table.create(n, 0)
	for _, muscle in ipairs(data.record.muscles) do
		local m = data.muscles[muscle]
		local biggest = 0
		for _, d in ipairs(m.disp) do biggest = math.max(biggest, d.Magnitude) end
		local idx, disp, nidx, ndisp = {}, {}, {}, {}
		local centerSum, normalSum, weightSum = Vector3.zero, Vector3.zero, 0
		for j, v in ipairs(m.idx) do
			local l = localOf[v]
			if l then
				table.insert(idx, l)
				table.insert(disp, m.disp[j])
				local w = if biggest > 0 then m.disp[j].Magnitude / biggest else 0
				if w > weight[l] then weight[l], dominant[l] = w, muscle end
				centerSum += data.base[v] * w
				normalSum += data.nbase[v] * w
				weightSum += w
			end
		end
		for j, v in ipairs(m.nidx) do
			local l = localOf[v]
			if l then
				table.insert(nidx, l)
				table.insert(ndisp, m.ndisp[j])
			end
		end
		if #idx > 0 then
			piece.muscles[muscle] = {
				idx = idx, disp = disp, nidx = nidx, ndisp = ndisp,
				-- the muscle's centre and average outward direction (for "is it facing the camera")
				center = if weightSum > 0 then centerSum / weightSum else Vector3.zero,
				normal = if normalSum.Magnitude > 1e-6 then normalSum.Unit else -Vector3.zAxis,
			}
			table.insert(piece.muscleNames, muscle)
		end
	end
	-- the shape layers (see addShape), in this piece's vertex ids; they count for their muscle's tint too
	piece.shapes, piece.shapeNames = {}, {}
	for muscle, s in pairs(data.shapes or {}) do
		local biggest = 0
		for _, d in ipairs(s.disp) do biggest = math.max(biggest, d.Magnitude) end
		local idx, disp, nidx, ndisp = {}, {}, {}, {}
		for j, v in ipairs(s.idx) do
			local l = localOf[v]
			if l then
				table.insert(idx, l)
				table.insert(disp, s.disp[j])
				local w = if biggest > 0 then s.disp[j].Magnitude / biggest else 0
				if piece.muscles[muscle] and w > weight[l] then weight[l], dominant[l] = w, muscle end
			end
		end
		for j, v in ipairs(s.nidx) do
			local l = localOf[v]
			if l then
				table.insert(nidx, l)
				table.insert(ndisp, s.ndisp[j])
			end
		end
		if #idx > 0 then
			piece.shapes[muscle] = { idx = idx, disp = disp, nidx = nidx, ndisp = ndisp }
			table.insert(piece.shapeNames, muscle)
		end
	end
	table.sort(piece.shapeNames)
	local top = MuscleMeshes.TintBands
	for i = 1, n do
		local t = math.clamp(weight[i], 0, 1)
		band[i] = math.floor(t * t * (3 - 2 * t) * top + 0.5)
		if band[i] == 0 then dominant[i] = false end
	end
	piece.dominant, piece.band = dominant, band
	assert(piece.triCount <= 20000, key .. " has more than 20,000 triangles")
	pieceCache[key] = piece
	return piece
end

------------------------------------------------------------------------
-- Shell meshes
------------------------------------------------------------------------
local shellCache: { [string]: any } = {}

-- Parsed data of one shell mesh (cached).
function MuscleMeshes.Load(name: string): any
	local found = shellCache[name]
	if found then return found end
	local record = MuscleMeshes.ByName[name]
	assert(record and record.format == "shell", "unknown shell muscle mesh " .. name)
	local base, max = vectors(numbers(record, "base")), vectors(numbers(record, "max"))
	local uvList = numbers(record, "uv")
	local count = record.verts
	local delta, uv = table.create(count), table.create(count)
	for i = 1, count do
		delta[i] = max[i] - base[i]
		uv[i] = Vector2.new(uvList[i * 2 - 1], uvList[i * 2])
	end
	local data = { base = base, delta = delta, uv = uv, tris = numbers(record, "tris"), verts = count, record = record }
	if record.chunks.nbase and record.chunks.nmax then
		local nb, nm = vectors(numbers(record, "nbase")), vectors(numbers(record, "nmax"))
		local ndelta = table.create(count)
		for i = 1, count do ndelta[i] = nm[i] - nb[i] end
		data.nbase, data.ndelta = nb, ndelta
	end
	if record.chunks.vein then data.vein = vectors(numbers(record, "vein")) end
	if record.chunks.morph then data.morph = vectors(numbers(record, "morph")) end
	-- border blend weights: "Name:vertex,weight,vertex,weight|Name2:..." (0-based) -> blends[vertex] = { { key, weight } }
	data.blends, data.blendKeys = {}, {}
	if record.chunks.blend then
		local pieces = {}
		for k = 1, record.chunks.blend do
			local module = Data:FindFirstChild(record.name .. "__blend" .. k)
			table.insert(pieces, module and (require(module :: ModuleScript) :: any) or "")
		end
		for block in string.gmatch(table.concat(pieces, ","), "[^|]+") do
			local other, list = string.match(block, "^([^:]+):(.*)$")
			if other then
				local key = MuscleMeshes.MeshKey(other)
				if not table.find(data.blendKeys, key) then table.insert(data.blendKeys, key) end
				local vertex = nil
				for value in string.gmatch(list, "[^,]+") do
					if vertex == nil then
						vertex = (tonumber(value) :: number) + 1
					else
						local slot = data.blends[vertex]
						if not slot then
							slot = {}
							data.blends[vertex] = slot
						end
						table.insert(slot, { key, tonumber(value) :: number })
						vertex = nil
					end
				end
			end
		end
	end
	shellCache[name] = data
	return data
end

-- The highlight / flash of a shell covers the muscle's AREA: full in the middle, fading over its last TintRows rows of
-- vertices to its border (an open edge, or where it blends into a neighbour), times how much each vertex stays its own.
local function tintBands(data): { number }
	local n, tris, blends = data.verts, data.tris, data.blends
	local adjacent, edgeUse = table.create(n), {}
	for i = 1, n do adjacent[i] = {} end
	for k = 1, #tris, 3 do
		local corners = { tris[k] + 1, tris[k + 1] + 1, tris[k + 2] + 1 }
		for c = 1, 3 do
			local a, b = corners[c], corners[c % 3 + 1]
			table.insert(adjacent[a], b)
			local key = if a < b then a * 65536 + b else b * 65536 + a
			edgeUse[key] = (edgeUse[key] or 0) + 1
		end
	end
	local own = table.create(n, 1)
	for i = 1, n do
		local list = blends and blends[i]
		if list then
			local o = 1
			for _, pair in ipairs(list) do o -= pair[2] end
			own[i] = math.clamp(o, 0, 1)
		end
	end
	local rows = table.create(n, math.huge)
	local queue, head = {}, 1
	for key, used in pairs(edgeUse) do
		if used == 1 then
			for _, v in ipairs({ key // 65536, key % 65536 }) do
				if rows[v] ~= 0 then rows[v] = 0 table.insert(queue, v) end
			end
		end
	end
	for i = 1, n do
		if own[i] < 0.5 and rows[i] ~= 0 then rows[i] = 0 table.insert(queue, i) end
	end
	while head <= #queue do
		local v = queue[head]
		head += 1
		for _, w in ipairs(adjacent[v]) do
			if rows[w] > rows[v] + 1 then
				rows[w] = rows[v] + 1
				table.insert(queue, w)
			end
		end
	end
	local bands = table.create(n)
	for i = 1, n do
		local t = math.clamp(rows[i] / MuscleMeshes.TintRows, 0, 1)
		t = t * t * (3 - 2 * t)
		bands[i] = math.floor(t * own[i] * MuscleMeshes.TintBands + 0.5)
	end
	return bands
end

-- Shell muscles sit this far off the skin (studs, along the base normal), so they never fight the body part for depth.
local SKIN_LIFT = 0.02
-- Under the shorts the thigh / glute muscles grow like fabric stretched over muscle, not like bare muscle (at full growth
-- the glutes and the tops of the quads flared out as a puffy inner tube, with a ledge at the hem): over a thigh mesh group
-- that has shorts, by the vertex's height (one curve for the skin and the shorts meshes, so they still meet at the hem):
-- full growth on the lower thigh, easing to SHORTS.Hug from HemBelow under the hem to HemAbove over it. (Not less at the
-- waistband: the waist piece above is wider than the bare thigh tops, so less growth there opened a lip.)
local SHORTS = { Hug = 0.5, HemBelow = 0.16, HemAbove = 0.08 }
-- The inner / front quads (owner, 19 Oct: kids' game): at big sizes the inner quad grew a round lump forward from the top of
-- the bare thigh, right under the shorts. By height on the BARE thigh (0 = its bottom, 1 = the shorts' hem): full growth up
-- to FadeFrom (the inner teardrop sits low, just above the knee), easing to none at FadeTo and above (the top of the bare
-- thigh and everything under the shorts stay flat). The outer sweep keeps its growth: OuterFrom .. OuterTo studs out from
-- the thigh's middle (part-local X, away from the body) blend back to full growth. One smooth curve over the skin and the
-- shorts meshes (they still meet at the hem). The body stage meshes are made from this same data (tools/gen_body_stages).
-- (owner, 19 Oct, second pass: "the ball bump on the inner quads is still there, remove it": the low inner teardrop kept
-- above the knee read as a ball. The inner side now gets no quad growth at any height: from InnerFrom to InnerTo studs
-- inward of the thigh's middle the growth eases out; the adductor fill below keeps the inner thigh smooth and full.)
local QUADS = { FadeFrom = 0.25, FadeTo = 0.6, OuterFrom = 0.05, OuterTo = 0.25, InnerFrom = 0.02, InnerTo = 0.16 }
-- The adductors (owner, 19 Oct prompt 8: "the inner thighs look empty"; the inner side was flat from mid thigh up). A shape
-- layer on the thigh (merged.shape, drawn with the Quads level and MonsterG("Quads@shape")) fills the INNER SIDE only, pushing
-- straight inward (never forward): up to an inner surface Target studs from the thigh's middle (part-local X; KneeTarget
-- at the knee, reached by RiseTo of the bare thigh's height), at most Max at the full look; only on the inner side
-- (InnerFrom .. InnerTo studs inward of the middle) and not on the front (FrontFrom .. FrontTo studs toward the front it
-- fades out); it fades out from FadeFrom to FadeTo of the bare thigh's height, so the top of the inner thigh near the
-- groin and everything under the shorts stays as it is (the quad fix above).
local ADDUCTORS = { Target = 0.47, KneeTarget = 0.4, RiseTo = 0.3, FadeFrom = 0.62, FadeTo = 0.9, InnerFrom = 0.1, InnerTo = 0.24, FrontFrom = 0.06, FrontTo = 0.22, Max = 0.16 }
local function smoothstep(t: number): number
	t = math.clamp(t, 0, 1)
	return t * t * (3 - 2 * t)
end
local groupCache: { [string]: any } = {}
-- The merged data of one shell group { part, records }: one set of arrays for all its meshes; each range (one mesh) knows
-- its muscle id, mesh key and the neighbouring keys it blends with.
function MuscleMeshes.LoadGroup(group: any): any
	local key = table.concat(group.records, "+")
	local found = groupCache[key]
	if found then return found end
	local base, delta, uv, tris, ranges = {}, {}, {}, {}, {}
	local nbase, ndelta, vein, blends, bands, morph, hug = {}, {}, {}, {}, {}, {}, {}
	local hasMorph, hasNormals, hasVeins, hasHug = false, true, true, false
	local hemY, topY = math.huge, -math.huge -- (the shorts' hem and waistband heights, when the group has shorts)
	local vertexCount, triCount = 0, 0
	for _, name in ipairs(group.records) do
		local data = MuscleMeshes.Load(name)
		local record = data.record
		table.insert(ranges, { id = record.id, key = record.key, shorts = record.shorts == true, first = vertexCount + 1, count = data.verts, blendKeys = data.blendKeys })
		hasNormals = hasNormals and data.nbase ~= nil
		hasVeins = hasVeins and data.vein ~= nil
		local centerSum, normalSum = Vector3.zero, Vector3.zero
		for i = 1, data.verts do
			local p = data.base[i] + data.delta[i] * 0.5
			centerSum += p
			normalSum += if data.nbase then data.nbase[i] + data.ndelta[i] * 0.5 else p
		end
		local range = ranges[#ranges]
		range.center = centerSum / math.max(data.verts, 1)
		range.normal = if normalSum.Magnitude > 1e-6 then normalSum.Unit else -Vector3.zAxis
		data.bands = data.bands or tintBands(data)
		-- a mesh that replaces its body part (forearms, calves) IS the skin: no lift
		local lift = if record.hidePart then 0 else SKIN_LIFT
		for i = 1, data.verts do
			local at = vertexCount + i
			base[at] = if data.nbase and data.nbase[i].Magnitude > 1e-6 then data.base[i] + data.nbase[i].Unit * lift else data.base[i]
			delta[at] = data.delta[i]
			uv[at] = data.uv[i]
			bands[at] = data.bands[i]
			if data.nbase then nbase[at], ndelta[at] = data.nbase[i], data.ndelta[i] end
			if data.vein then vein[at] = data.vein[i] end
			blends[at] = data.blends[i]
			if data.morph then morph[at] = data.morph[i] end
		end
		if record.shorts then
			for i = 1, data.verts do
				local y = data.base[i].Y
				hemY = math.min(hemY, y)
				topY = math.max(topY, y)
			end
		end
		hasMorph = hasMorph or data.morph ~= nil
		local t = data.tris
		for k = 1, #t, 3 do
			triCount += 1
			tris[triCount * 3 - 2] = t[k] + vertexCount
			tris[triCount * 3 - 1] = t[k + 1] + vertexCount
			tris[triCount * 3] = t[k + 2] + vertexCount
		end
		vertexCount += data.verts
	end
	assert(triCount <= 20000, "group " .. key .. " has more than 20,000 triangles")
	if topY - hemY > SHORTS.HemAbove then
		hasHug = true
		for i = 1, vertexCount do
			local y = base[i].Y
			local up = smoothstep((y - (hemY - SHORTS.HemBelow)) / (SHORTS.HemBelow + SHORTS.HemAbove)) -- 0 low on the thigh .. 1 over the hem
			hug[i] = 1 - (1 - SHORTS.Hug) * up
		end
	end
	if hemY < math.huge and (group.part == "LeftUpperLeg" or group.part == "RightUpperLeg") then
		local bottomY = math.huge
		for i = 1, vertexCount do bottomY = math.min(bottomY, base[i].Y) end
		local outward = if group.part == "LeftUpperLeg" then -1 else 1 -- (part-local X pointing away from the body)
		for _, range in ipairs(ranges) do
			-- (the hamstrings' inner side too: at big sizes it made a round lump between the knees; owner, 19 Oct)
			if range.id ~= "Quads" and range.id ~= "Hamstrings" then continue end
			local quads = range.id == "Quads"
			for i = range.first, range.first + range.count - 1 do
				local p = base[i]
				local fade = if quads then smoothstep(((p.Y - bottomY) / math.max(hemY - bottomY, 0.01) - QUADS.FadeFrom) / (QUADS.FadeTo - QUADS.FadeFrom)) else 0
				local outer = smoothstep((p.X * outward - QUADS.OuterFrom) / (QUADS.OuterTo - QUADS.OuterFrom))
				local inner = smoothstep((-p.X * outward - QUADS.InnerFrom) / (QUADS.InnerTo - QUADS.InnerFrom))
				local w = (1 - fade * (1 - outer)) * (1 - inner)
				if w < 1 then
					delta[i] *= w
					if hasNormals and ndelta[i] then ndelta[i] *= w end
					if vein[i] then vein[i] *= w end
				end
			end
		end
	end
	local shape, nshape = nil, nil
	if hemY < math.huge and (group.part == "LeftUpperLeg" or group.part == "RightUpperLeg") then
		local A = ADDUCTORS
		local bottomY = math.huge
		for i = 1, vertexCount do bottomY = math.min(bottomY, base[i].Y) end
		local inward = if group.part == "LeftUpperLeg" then 1 else -1 -- (part-local X pointing toward the other leg)
		for i = 1, vertexCount do
			local p = base[i]
			local h = (p.Y - bottomY) / math.max(hemY - bottomY, 0.01)
			local wh = smoothstep(h / 0.08) * (1 - smoothstep((h - A.FadeFrom) / (A.FadeTo - A.FadeFrom)))
			local wi = smoothstep((p.X * inward - A.InnerFrom) / (A.InnerTo - A.InnerFrom))
			local wf = 1 - smoothstep((-p.Z - A.FrontFrom) / (A.FrontTo - A.FrontFrom))
			local w = wh * wi * wf
			if w <= 0.001 then continue end
			local grown = (p.X + delta[i].X * (if hasHug and hug[i] then hug[i] else 1)) * inward
			local target = A.KneeTarget + (A.Target - A.KneeTarget) * smoothstep(h / A.RiseTo)
			local fill = math.clamp(target - grown, 0, A.Max) * w
			if fill > 0.001 then
				shape = shape or {}
				shape[i] = Vector3.new(fill * inward, 0, 0)
			end
		end
		if shape and hasNormals then
			-- the light follows the filled shape (the geometric normal change, like the unified reshapes)
			local plainPos, filledPos = table.create(vertexCount), table.create(vertexCount)
			for i = 1, vertexCount do
				local g = if hasHug and hug[i] then hug[i] else 1
				plainPos[i] = base[i] + delta[i] * g
				filledPos[i] = plainPos[i] + (shape[i] or Vector3.zero)
			end
			local probe = { base = base, tris = tris }
			local plainN, filledN = vertexNormals(probe, plainPos), vertexNormals(probe, filledPos)
			nshape = {}
			for i in pairs(shape) do nshape[i] = filledN[i] - plainN[i] end
		end
	end
	local merged = { verts = vertexCount, base = base, delta = delta, uv = uv, tris = tris, blends = blends, bands = bands,
		morph = if hasMorph then morph else nil, nbase = hasNormals and nbase or nil, ndelta = hasNormals and ndelta or nil,
		vein = hasVeins and vein or nil, clothing = MuscleMeshes.ByName[group.records[1]].clothing or "Shirt", ranges = ranges,
		triCount = triCount, hug = if hasHug then hug else nil, shape = shape, nshape = nshape, shapeMuscle = if shape then "Quads" else nil }
	if shape then
		for _, range in ipairs(ranges) do
			for i = range.first, range.first + range.count - 1 do
				if shape[i] then range.hasShape = true break end
			end
		end
	end
	groupCache[key] = merged
	return merged
end

------------------------------------------------------------------------
-- The snatched-waist LowerTorso (shown instead of the real one): { verts, uv, tris (0-based), normals?, start? } in
-- part-local studs; a vertex sits at start + (verts - start) * waistT as the body grows.
------------------------------------------------------------------------
local snatchedCache: { [string]: any } = {}
function MuscleMeshes.LoadSnatched(part: string): any
	local found = snatchedCache[part]
	if found then return found end
	local module = Data:FindFirstChild("Snatched" .. part)
	if not module or not module:IsA("ModuleScript") then return nil end
	local raw = require(module) :: any
	local verts, uv = vectors(raw.verts), {}
	for i = 1, #raw.verts // 3 do uv[i] = Vector2.new(raw.uv[i * 2 - 1], raw.uv[i * 2]) end
	local data = { verts = verts, uv = uv, tris = raw.tris, normals = nil :: { Vector3 }?, start = nil :: { Vector3 }? }
	if raw.start and #raw.start == #raw.verts then data.start = vectors(raw.start) end
	if raw.normals and #raw.normals == #raw.verts then
		local normals = vectors(raw.normals)
		for i, n in ipairs(normals) do normals[i] = if n.Magnitude > 1e-6 then n.Unit else Vector3.yAxis end
		data.normals = normals
	end
	snatchedCache[part] = data
	return data
end

------------------------------------------------------------------------
-- Units: what MuscleRig builds, in this order of importance (a client holds a limited EditableMesh budget). A UNIT grows
-- together (both sides of a pair, or the torso's two halves); a GROUP is one EditableMesh on one body part.
--   kind "unified": a piece of a unified mesh (hides the body part: the mesh is its whole skin)
--   kind "shell":   merged shell meshes (records); hidePart = they cover the body part, which is hidden
--   kind "snatched": the snatched LowerTorso
------------------------------------------------------------------------
local function shells(part: string, list: { string }): { string }
	local out = {}
	for _, muscle in ipairs(list) do table.insert(out, part .. "__" .. muscle) end
	return out
end
local function shellPair(list: { string }, a: string, b: string)
	return { { kind = "shell", part = a, records = shells(a, list) }, { kind = "shell", part = b, records = shells(b, list) } }
end
-- groups whose meshes cover their whole body part: the plain (blocky) part is hidden under them
local function covering(groups)
	for _, group in ipairs(groups) do group.hidePart = true end
	return groups
end
MuscleMeshes.Units = {
	{ id = "Torso", alwaysWanted = true, groups = {
		{ kind = "unified", part = "UpperTorso", mesh = "UpperTorso__Unified", half = "Front" },
		{ kind = "unified", part = "UpperTorso", mesh = "UpperTorso__Unified", half = "Back" },
	} },
	{ id = "Snatched", alwaysWanted = true, groups = { { kind = "snatched", part = "LowerTorso" } } },
	-- (the arms and legs from level 0 too: without them the plain blocky Robloxian parts show)
	{ id = "UpperArms", alwaysWanted = true, groups = {
		{ kind = "unified", part = "RightUpperArm", mesh = "RightUpperArm__Unified" },
		{ kind = "unified", part = "LeftUpperArm", mesh = "LeftUpperArm__Unified" },
	} },
	-- (the quads, hamstrings and glutes with their shorts cover the whole thigh: checked in Studio, 8 Oct)
	{ id = "UpperLegs", alwaysWanted = true, groups = covering(shellPair({ "Quads", "Quads_Shorts", "Hamstrings", "Hamstrings_Shorts", "Glutes", "Glutes_Shorts" }, "RightUpperLeg", "LeftUpperLeg")) },
	{ id = "Forearms", liveOnly = true, groups = shellPair({ "Forearms" }, "RightLowerArm", "LeftLowerArm") },
	{ id = "Calves", liveOnly = true, groups = shellPair({ "Calves" }, "RightLowerLeg", "LeftLowerLeg") },
}
for _, unit in ipairs(MuscleMeshes.Units) do
	unit.cost = #unit.groups
	unit.muscles = {}
	for _, group in ipairs(unit.groups) do
		if group.kind == "unified" then
			for _, muscle in ipairs(MuscleMeshes.ByName[group.mesh].muscles) do unit.muscles[muscle] = true end
		elseif group.kind == "shell" then
			for _, name in ipairs(group.records) do
				local record = MuscleMeshes.ByName[name]
				assert(record, "unknown muscle mesh " .. name)
				unit.muscles[record.id] = true
				if record.hidePart then group.hidePart = true end
			end
		end
	end
end

return MuscleMeshes
