-- generated by tools/torso_uv_patch.py: the torso's texture coordinates (see MuscleMeshes applyUVPatch); the
-- lists are in the modules <this name>_1 .. _5 beside it (a script holds under 200,000 characters)
local out = { verts = 21507, triCount = 42812, uv = {}, faces = {} }
for i = 1, 5 do
	for key, list in pairs(require(script.Parent:WaitForChild(script.Name .. "_" .. i))) do
		table.move(list, 1, #list, #out[key] + 1, out[key])
	end
end
return out
